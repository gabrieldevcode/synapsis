# ─── User data ───────────────────────────────────────────────────────────────
# Each folder in users/ holds the student's profile file (name, password and
# coefficient) and every piece of content they registered. None of it may be
# versioned: it is personal data, and the password is stored in plain text.
users/

# Legacy data folder from the Portuguese version of the program. Kept ignored
# so old local data can never be committed by accident.
usuarios/

# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# ─── Tools and editors ───────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.vscode/
.idea/
*.swp

# ─── Operating system ────────────────────────────────────────────────────────
Thumbs.db
desktop.ini
.DS_Store
